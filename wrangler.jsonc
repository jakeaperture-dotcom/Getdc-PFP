{
  "name": "getdcpfp",
  "main": "worker.js",
  "compatibility_date": "2026-08-02",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/", "/*.html", "/api/*", "/healthz"]
  },
  "ratelimits": [
    {
      "name": "API_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 30,
        "period": 60
      }
    }
  ]
}
