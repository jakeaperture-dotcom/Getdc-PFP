{
  "name": "getdcpfp",
  "main": "worker.js",
  "compatibility_date": "2026-08-02",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/", "/host", "/host/*", "/*.html", "/api/*", "/healthz"]
  },
  "r2_buckets": [
    {
      "binding": "HOST_FILES",
      "bucket_name": "getdc-host-files"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "POST_HUB",
        "class_name": "PostHub"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["PostHub"]
    }
  ],
  "ratelimits": [
    {
      "name": "API_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 30,
        "period": 60
      }
    }
  ]
}
