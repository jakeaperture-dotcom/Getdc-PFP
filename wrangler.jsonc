{
  "name": "getdcpfp",
  "main": "worker.js",
  "compatibility_date": "2026-08-02",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/", "/host", "/host/*", "/*.html", "/api/*", "/healthz"]
  },
  "ai": {
    "binding": "AI"
  },
  "vectorize": [
    {
      "binding": "FRIDAY_KNOWLEDGE",
      "index_name": "friday-knowledge"
    }
  ],
  "vars": {
    "FRIDAY_DAILY_LIMIT": "20",
    "FRIDAY_DEVICE_LIMIT": "8",
    "FRIDAY_MAX_OUTPUT_TOKENS": "600"
  },
  "r2_buckets": [
    {
      "binding": "HOST_FILES",
      "bucket_name": "getdc-host-files"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "POST_HUB",
        "class_name": "PostHub"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["PostHub"]
    }
  ],
  "ratelimits": [
    {
      "name": "API_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 30,
        "period": 60
      }
    }
  ]
}
